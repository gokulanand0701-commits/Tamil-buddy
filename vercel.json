{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/lessons/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/letters/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/words/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/attempts/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/speech/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/progress/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/parent/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/review/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
