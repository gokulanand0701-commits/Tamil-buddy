# Database Configuration (SQLite default, easy swap to PostgreSQL)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/tamil_buddy
DATABASE_URL=sqlite:///./tamil_buddy.db

# Authentication
SECRET_KEY=tamilbuddy-super-secret-key-change-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Services
# Leave empty to use built-in mock fallback for Kili the parrot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Speech to Text Provider ("mock", "google", or "whisper")
STT_PROVIDER=mock
